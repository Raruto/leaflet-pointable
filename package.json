{
  "name": "leaflet-pointable",
  "version": "0.2.2",
  "description": "A Leaflet plugin that allows to interact with semi-transparent tiled overlays",
  "main": "leaflet-pointable.js",
  "scripts": {
    "dev": "node build/server.js",
    "build": "esbuild leaflet-pointable.js --minify --outfile=leaflet-pointable.min.js",
    "test": "npm run build && cucumber-js",
    "preversion": "node -e \"console.error('Versioning is handled by GitHub Actions; do not run npm version locally.'); process.exit(1)\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Raruto/leaflet-pointable.git"
  },
  "keywords": [
    "leaflet",
    "pointable",
    "overlay",
    "transparency"
  ],
  "author": "Raruto",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/Raruto/leaflet-pointable/issues"
  },
  "homepage": "https://github.com/Raruto/leaflet-pointable#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1"
  },
  "peerDependencies": {
    "leaflet": "^1.9.4 || ^2.0.0-beta.3"
  }
}
